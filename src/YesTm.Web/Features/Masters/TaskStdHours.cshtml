@page
@model YesTm.Web.Features.Masters.TaskStdHoursModel
@{
    ViewData["Title"] = "Task Standard Hours";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><span class="ico"><i class="fa-solid fa-stopwatch"></i></span> Task Standard Hours</h1>
        <p class="page-sub">"Cheat-sheet" standard hours per task, keyed by Manufacturer · Model · Series · Component · Task.</p>
    </div>
    <button class="btn btn-primary" data-master-add data-title="Add Standard"><i class="fa-solid fa-plus me-2"></i>Add Standard</button>
</div>

@if (Model.IsOffline)
{
    <div class="alert alert-warning"><i class="fa-solid fa-plug-circle-xmark me-2"></i>Database not reachable.</div>
}

<div class="content-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Manufacturer</th><th>Model</th><th>Series</th><th>Component</th><th>Task</th><th class="text-num">Std Hrs</th><th>Status</th><th style="width:160px"></th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="8" class="grid-empty">No task standards defined.</td></tr>
                }
                else
                {
                    @foreach (var s in Model.Items)
                    {
                        var active = (s.ACTIVE_YN ?? "Y") == "Y";
                        <tr class="@(active ? "" : "text-muted")">
                            <td class="fw-semibold">@s.TST_MANUFACTURER</td>
                            <td>@s.TST_MODEL</td>
                            <td>@s.TST_SERIES</td>
                            <td>@s.TST_COMPONENT</td>
                            <td>@s.TST_TASK_CODE @(string.IsNullOrEmpty(s.TASK_NAME) ? "" : $"· {s.TASK_NAME}")</td>
                            <td class="text-num">@s.TST_STD_HOURS.ToString("N2")</td>
                            <td>
                                @if (active) { <span class="badge-soft badge-normal">Active</span> }
                                else { <span class="badge-soft" style="background:#eee;color:#888">Inactive</span> }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" data-row="@System.Text.Json.JsonSerializer.Serialize(s)"><i class="fa-solid fa-pen"></i></button>
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="id" value="@s.TST_ID" />
                                    <input type="hidden" name="active" value="@(active ? "N" : "Y")" />
                                    <button class="btn btn-sm @(active ? "btn-outline-danger" : "btn-outline-success")">
                                        <i class="fa-solid @(active ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="masterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Save" id="masterForm" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="masterModalTitle">Add Standard</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="IsEdit" value="false" />
                <input type="hidden" name="Input.TST_ID" data-default="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Manufacturer</label>
                        <input name="Input.TST_MANUFACTURER" class="form-control" maxlength="50" placeholder="e.g. Allison" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Model</label>
                        <input name="Input.TST_MODEL" class="form-control" maxlength="50" placeholder="e.g. 4000" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Series</label>
                        <input name="Input.TST_SERIES" class="form-control" maxlength="50" placeholder="e.g. S-X42" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Component</label>
                        <input name="Input.TST_COMPONENT" class="form-control" maxlength="50" placeholder="e.g. Transmission" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Task <span class="req">*</span></label>
                        <select name="Input.TST_TASK_CODE" class="form-select" required>
                            <option value="">—</option>
                            @foreach (var t in Model.Tasks)
                            {
                                <option value="@t.CODE">@t.CODE — @t.NAME</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Standard Hours <span class="req">*</span></label>
                        <input name="Input.TST_STD_HOURS" type="number" step="0.25" min="0" class="form-control" required data-default="0" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Acceptance Benchmark</label>
                        <input name="Input.TST_ACCEPT_BENCHMARK" class="form-control" maxlength="200" />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Status</label>
                        <select name="Input.ACTIVE_YN" class="form-select" data-default="Y">
                            <option value="Y">Active</option>
                            <option value="N">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/masters.js" asp-append-version="true"></script>
}
