@page
@model YesTm.Web.Features.Masters.WorkTypeModel
@{
    ViewData["Title"] = "Work Types";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><span class="ico"><i class="fa-solid fa-briefcase"></i></span> Work / Labour Type</h1>
        <p class="page-sub">Chargeable, warranty and non-chargeable work types — drive cost treatment (COGS vs charge rate).</p>
    </div>
    <button class="btn btn-primary" data-master-add data-title="Add Work Type"><i class="fa-solid fa-plus me-2"></i>Add Work Type</button>
</div>

@if (Model.IsOffline)
{
    <div class="alert alert-warning"><i class="fa-solid fa-plug-circle-xmark me-2"></i>Database not reachable.</div>
}

<div class="content-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr><th>Code</th><th>Name</th><th>Category</th><th>Cost Treatment</th><th>Sub-Type</th><th>Status</th><th style="width:160px"></th></tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="7" class="grid-empty">No work types defined.</td></tr>
                }
                else
                {
                    @foreach (var w in Model.Items)
                    {
                        var active = (w.ACTIVE_YN ?? "Y") == "Y";
                        <tr class="@(active ? "" : "text-muted")">
                            <td class="fw-semibold">@w.WORK_TYPE_CODE</td>
                            <td>@w.WORK_TYPE_NAME</td>
                            <td>@w.CATEGORY</td>
                            <td>@w.COST_TREATMENT</td>
                            <td>@w.SUB_TYPE</td>
                            <td>
                                @if (active) { <span class="badge-soft badge-normal">Active</span> }
                                else { <span class="badge-soft" style="background:#eee;color:#888">Inactive</span> }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" data-row="@System.Text.Json.JsonSerializer.Serialize(w)"><i class="fa-solid fa-pen"></i></button>
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="code" value="@w.WORK_TYPE_CODE" />
                                    <input type="hidden" name="active" value="@(active ? "N" : "Y")" />
                                    <button class="btn btn-sm @(active ? "btn-outline-danger" : "btn-outline-success")" title="@(active ? "Deactivate" : "Activate")">
                                        <i class="fa-solid @(active ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="masterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Save" id="masterForm" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="masterModalTitle">Add Work Type</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="IsEdit" value="false" />
                <div class="mb-3">
                    <label class="form-label">Code <span class="req">*</span></label>
                    <input name="Input.WORK_TYPE_CODE" class="form-control" data-key-field required maxlength="15" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Name <span class="req">*</span></label>
                    <input name="Input.WORK_TYPE_NAME" class="form-control" required maxlength="100" />
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Category</label>
                        <select name="Input.CATEGORY" class="form-select">
                            <option value="">—</option>
                            <option value="CHARGEABLE">Chargeable</option>
                            <option value="NONCHARGEABLE">Non-Chargeable</option>
                            <option value="WARRANTY">Warranty</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Cost Treatment</label>
                        <select name="Input.COST_TREATMENT" class="form-select">
                            <option value="">—</option>
                            <option value="REVENUE">Revenue (Charge Rate)</option>
                            <option value="EXPENSE">Expense (COGS)</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Sub-Type</label>
                        <input name="Input.SUB_TYPE" class="form-control" maxlength="30" placeholder="Training, Redo, Idle…" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <select name="Input.ACTIVE_YN" class="form-select" data-default="Y">
                            <option value="Y">Active</option>
                            <option value="N">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/masters.js" asp-append-version="true"></script>
}
