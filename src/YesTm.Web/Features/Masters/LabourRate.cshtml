@page
@model YesTm.Web.Features.Masters.LabourRateModel
@{
    ViewData["Title"] = "Labour Rates";
}

<div class="page-head">
    <div>
        <h1 class="page-title"><span class="ico"><i class="fa-solid fa-money-bill-wave"></i></span> Labour Rate</h1>
        <p class="page-sub">Rate by Location × Industry × Time Type. The same rate applies to all technicians; OT uses the multiplier.</p>
    </div>
    <button class="btn btn-primary" data-master-add data-title="Add Labour Rate"><i class="fa-solid fa-plus me-2"></i>Add Rate</button>
</div>

@if (Model.IsOffline)
{
    <div class="alert alert-warning"><i class="fa-solid fa-plug-circle-xmark me-2"></i>Database not reachable.</div>
}

<div class="content-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead><tr><th>Location</th><th>Industry</th><th>Time Type</th><th class="text-num">Charge Rate</th><th class="text-num">Cost Rate</th><th class="text-num">OT ×</th><th class="text-num">Food Allow.</th><th>Effective</th><th>Status</th><th style="width:160px"></th></tr></thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="10" class="grid-empty">No labour rates defined.</td></tr>
                }
                else
                {
                    @foreach (var r in Model.Items)
                    {
                        var active = (r.LR_ACTIVE_YN ?? "Y") == "Y";
                        <tr class="@(active ? "" : "text-muted")">
                            <td class="fw-semibold">@r.LR_LOCATION</td>
                            <td>@r.LR_INDUSTRY_CODE</td>
                            <td>@r.LR_TIME_TYPE</td>
                            <td class="text-num">@r.LR_RATE.ToString("N2")</td>
                            <td class="text-num">@(r.LR_COST_RATE?.ToString("N2"))</td>
                            <td class="text-num">@(r.LR_OT_MULTIPLIER?.ToString("N2"))</td>
                            <td class="text-num">@(r.LR_FOOD_ALLOWANCE?.ToString("N2"))</td>
                            <td>@(r.LR_EFFECTIVE_FROM?.ToString("dd-MMM-yyyy"))</td>
                            <td>
                                @if (active) { <span class="badge-soft badge-normal">Active</span> }
                                else { <span class="badge-soft" style="background:#eee;color:#888">Inactive</span> }
                            </td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-primary" data-row="@System.Text.Json.JsonSerializer.Serialize(r)"><i class="fa-solid fa-pen"></i></button>
                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                    <input type="hidden" name="id" value="@r.LR_ID" />
                                    <input type="hidden" name="active" value="@(active ? "N" : "Y")" />
                                    <button class="btn btn-sm @(active ? "btn-outline-danger" : "btn-outline-success")">
                                        <i class="fa-solid @(active ? "fa-ban" : "fa-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="masterModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <form method="post" asp-page-handler="Save" id="masterForm" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="masterModalTitle">Add Labour Rate</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" name="IsEdit" value="false" />
                <input type="hidden" name="Input.LR_ID" data-default="0" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Location <span class="req">*</span></label>
                        <select name="Input.LR_LOCATION" class="form-select" required>
                            <option value="">—</option>
                            <option>Field</option><option>Workshop</option><option>Service</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Industry</label>
                        <select name="Input.LR_INDUSTRY_CODE" class="form-select">
                            <option value="">(any)</option>
                            @foreach (var i in Model.Industries)
                            {
                                <option value="@i.INDUSTRY_CODE">@i.INDUSTRY_CODE — @i.INDUSTRY_NAME</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Time Type</label>
                        <select name="Input.LR_TIME_TYPE" class="form-select" data-default="NORMAL">
                            <option value="NORMAL">Normal</option>
                            <option value="OVERTIME">Overtime</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">OT Multiplier</label>
                        <input name="Input.LR_OT_MULTIPLIER" type="number" step="0.1" min="1" class="form-control" data-default="1.5" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Charge Rate <span class="req">*</span></label>
                        <input name="Input.LR_RATE" type="number" step="0.01" min="0" class="form-control" required data-default="0" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Cost Rate (COGS)</label>
                        <input name="Input.LR_COST_RATE" type="number" step="0.01" min="0" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Food Allowance (per line)</label>
                        <input name="Input.LR_FOOD_ALLOWANCE" type="number" step="0.01" min="0" class="form-control" data-default="0" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Effective From</label>
                        <input name="Input.LR_EFFECTIVE_FROM" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Status</label>
                        <select name="Input.LR_ACTIVE_YN" class="form-select" data-default="Y">
                            <option value="Y">Active</option>
                            <option value="N">Inactive</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Save</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/masters.js" asp-append-version="true"></script>
}
