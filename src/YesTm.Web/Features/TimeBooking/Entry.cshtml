@page
@model YesTm.Web.Features.TimeBooking.EntryModel
@{
    ViewData["Title"] = "Time Booking";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css" />
}

<div class="page-head">
    <div>
        <h1 class="page-title"><span class="ico"><i class="fa-solid fa-clock"></i></span>
            @(Model.IsEditMode ? $"Edit Time Sheet {Model.SheetNo}" : "Time Booking Posting")</h1>
        <p class="page-sub">Book technician time against a Work Order at <strong>Task</strong> level — <strong>one time sheet per Job</strong>. Net hours, Normal/Overtime split, rates, labour cost and food allowance are calculated as you enter each task and can be adjusted before posting.</p>
    </div>
    <a asp-page="/TimeBooking/Index" class="btn btn-outline-secondary"><i class="fa-solid fa-list me-2"></i>All Time Sheets</a>
</div>

@if (Model.IsOffline)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="fa-solid fa-plug-circle-xmark me-2"></i>
        <span>Database not reachable — showing <strong>demo lookups</strong>. Configure the Oracle connection string to use live data. Posting requires a live connection.</span>
    </div>
}

<form method="post" id="timeBookingForm">
    <div asp-validation-summary="All" class="alert alert-danger py-2" id="serverErrors"></div>
    @if (Model.ConflictingSheet is not null)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between" role="alert">
            <span><i class="fa-solid fa-file-circle-exclamation me-2"></i>Time sheet <strong>@Model.ConflictingSheet.TS_SHEET_NO</strong> already exists for job <strong>@Model.ConflictingSheet.TS_JOB_CODE</strong>.</span>
            <a asp-page="/TimeBooking/Entry" asp-route-tsId="@Model.ConflictingSheet.TS_ID" class="btn btn-sm btn-warning"><i class="fa-solid fa-arrow-up-right-from-square me-1"></i>Open that sheet</a>
        </div>
    }
    <input asp-for="TsId" type="hidden" />

    <div class="content-card">
        <div class="section-h"><i class="fa-solid fa-filter"></i> Find Job / Work Order</div>
        <div class="row g-3 mb-1">
            <div class="col-md-4">
                <label class="form-label">Filter Jobs by Location</label>
                <select id="jobLocFilter" class="form-select" @(Model.IsEditMode ? "disabled" : "")
                        title="@(Model.IsEditMode ? "Location filter is only available when creating a new time sheet." : "Filter the Job / Work Order list by location.")">
                    <option value="">All Locations</option>
                    @foreach (var loc in Model.Locations)
                    {
                        <option value="@loc.CODE">@loc.NAME</option>
                    }
                </select>
                @if (Model.IsEditMode)
                {
                    <span class="text-muted small"><i class="fa-regular fa-circle-question me-1"></i>Disabled while editing a posted sheet.</span>
                }
            </div>
            <div class="col-md-4">
                <label class="form-label">Selected Job Code <span class="badge-soft badge-status">auto</span></label>
                <input id="selectedJobCode" class="form-control field-auto" readonly value="@Model.Header.JobCode" />
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="section-h"><i class="fa-solid fa-file-lines"></i> Work Order Header</div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">Time Sheet No</label>
                <input class="form-control field-auto" value="@(Model.IsEditMode ? Model.SheetNo : "Auto Generated")" disabled />
            </div>
            <div class="col-md-3">
                <label class="form-label">Posting Date <span class="req">*</span></label>
                <input asp-for="Header.PostingDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Job No / Work Order <span class="req">*</span></label>
                <select asp-for="Header.JobCode" id="jobSelect" class="form-select">
                    <option value="">— Select Job —</option>
                    @foreach (var j in Model.Jobs)
                    {
                        Model.ExistingSheetNos.TryGetValue(j.MTJ_JOB_CODE, out var existingSheet);
                        <option value="@j.MTJ_JOB_CODE"
                                data-customer-code="@j.MTJ_PARTY_CODE"
                                data-customer-name="@j.CUSTOMER_NAME"
                                data-industry="@j.INDUSTRY_CODE"
                                data-location="@j.MTJ_JOB_LOCATION"
                                data-brand="@j.BRAND_DESC"
                                data-equip-type="@j.EQUIPMENT_TYPE_DESC"
                                data-service-type="@j.SERVICE_TYPE_DESC"
                                data-serial="@j.MTJ_SERIAL_NO"
                                data-opening="@(j.MTJ_JOB_OPENING_DATE?.ToString("dd-MMM-yyyy HH:mm"))"
                                data-sheet-no="@existingSheet">
                            @j.MTJ_JOB_CODE — @j.MTJ_JOB_DESC@(existingSheet is null ? "" : $"  ✓ {existingSheet}")
                        </option>
                    }
                </select>
                <span asp-validation-for="Header.JobCode" class="text-danger small"></span>
                <span class="text-muted small"><i class="fa-regular fa-circle-question me-1"></i>Jobs marked ✓ already have a time sheet — selecting one offers to open it.</span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Customer <span class="badge-soft badge-status">auto</span></label>
                <input asp-for="Header.CustomerName" id="customerName" class="form-control field-auto" readonly />
                <input asp-for="Header.CustomerCode" id="customerCode" type="hidden" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Job Opening Date &amp; Time <span class="badge-soft badge-status">auto</span></label>
                <input asp-for="Header.JobOpeningDate" id="openingDate" class="form-control field-auto" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Industry <span class="badge-soft badge-status">auto</span></label>
                <input asp-for="Header.IndustryCode" id="industryCode" class="form-control field-auto" readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Equipment Brand <span class="badge-soft badge-status">auto</span></label>
                <input asp-for="Header.Brand" id="brand" class="form-control field-auto" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Equipment Type <span class="badge-soft badge-status">auto</span></label>
                <input asp-for="Header.EquipmentType" id="equipType" class="form-control field-auto" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Type of Service <span class="badge-soft badge-status">auto</span></label>
                <input asp-for="Header.ServiceType" id="serviceType" class="form-control field-auto" readonly />
            </div>
            <div class="col-md-3">
                <label class="form-label">Machine / Gen Set S.No <span class="badge-soft badge-status">auto</span></label>
                <input asp-for="Header.SerialNo" id="serialNo" class="form-control field-auto" readonly />
            </div>

            <div class="col-md-3">
                <label class="form-label">Job Location <span class="req">*</span></label>
                <select asp-for="Header.Location" id="location" class="form-select">
                    @foreach (var loc in Model.Locations)
                    {
                        <option value="@loc.CODE">@loc.NAME</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Work / Labour Type <span class="req">*</span></label>
                <select asp-for="Header.WorkTypeCode" class="form-select">
                    <option value="">— Select —</option>
                    @foreach (var w in Model.WorkTypes)
                    {
                        <option value="@w.WORK_TYPE_CODE">@w.WORK_TYPE_NAME</option>
                    }
                </select>
                <span asp-validation-for="Header.WorkTypeCode" class="text-danger small"></span>
            </div>
            <div class="col-md-3">
                <label class="form-label">Job Status <span class="req">*</span></label>
                <select asp-for="Header.JobStatus" class="form-select">
                    <option>In Progress</option><option>Completed</option><option>On Hold</option>
                </select>
            </div>
        </div>
    </div>

    <div class="content-card">
        <div class="section-h">
            <i class="fa-solid fa-list-check"></i> Time Lines — booked per Task
            <button type="button" id="addTaskBtn" class="btn btn-primary btn-sm ms-auto" data-bs-toggle="modal" data-bs-target="#addTaskModal">
                <i class="fa-solid fa-plus me-1"></i> Add Task
            </button>
        </div>

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle tm-lines" id="linesTable">
                <thead>
                    <tr>
                        <th style="width:34px">#</th>
                        <th>Date</th>
                        <th>Task</th>
                        <th>Technician</th>
                        <th>Loc</th>
                        <th>Time</th>
                        <th class="text-num">Lunch</th>
                        <th class="text-num">Net</th>
                        <th class="text-num">Normal</th>
                        <th class="text-num">OT</th>
                        <th class="text-num">Rate / OT</th>
                        <th class="text-num">Labour</th>
                        <th class="text-num">Food</th>
                        <th class="text-num">Total</th>
                        <th>Travel</th>
                        <th style="width:78px"></th>
                    </tr>
                </thead>
                <tbody id="linesBody">
                    <!-- rows injected by JS -->
                </tbody>
                <tfoot>
                    <tr class="fw-semibold">
                        <td colspan="7" class="text-end">Total</td>
                        <td class="text-num" id="footNet">0.00</td>
                        <td class="text-num" id="footNormal">0.00</td>
                        <td class="text-num" id="footOt">0.00</td>
                        <td></td>
                        <td class="text-num" id="footCost">0.00</td>
                        <td class="text-num" id="footFood">0.00</td>
                        <td class="text-num" id="footTotal">0.00</td>
                        <td class="text-num" id="footTravel">0.00 h</td>
                        <td></td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div id="emptyGrid" class="grid-empty">
            <i class="fa-solid fa-inbox fa-lg d-block mb-2"></i>
            No task lines yet. Click <strong>Add Task</strong> to add the first line.
        </div>
    </div>

    <div class="content-card">
        <div class="section-h"><i class="fa-solid fa-chart-simple"></i> Summary</div>
        <div class="kpi-grid">
            <div class="kpi-card"><div class="kpi-icon bg-grad-blue"><i class="fa-solid fa-hourglass-half"></i></div>
                <div class="kpi-val" id="sumNet">0.00</div><div class="kpi-lbl">Net Labour Hours</div></div>
            <div class="kpi-card"><div class="kpi-icon bg-grad-amber"><i class="fa-solid fa-business-time"></i></div>
                <div class="kpi-val" id="sumSplit">0.0 / 0.0</div><div class="kpi-lbl">Normal / Overtime Hrs</div></div>
            <div class="kpi-card"><div class="kpi-icon bg-grad-green"><i class="fa-solid fa-coins"></i></div>
                <div class="kpi-val" id="sumCost">0.00</div><div class="kpi-lbl">Labour Cost</div></div>
            <div class="kpi-card"><div class="kpi-icon bg-grad-purple"><i class="fa-solid fa-utensils"></i></div>
                <div class="kpi-val" id="sumFood">0.00</div><div class="kpi-lbl">Food Allowance</div></div>
            <div class="kpi-card"><div class="kpi-icon bg-grad-blue"><i class="fa-solid fa-sack-dollar"></i></div>
                <div class="kpi-val" id="sumTotal">0.00</div><div class="kpi-lbl">Total Cost (Labour + Food)</div></div>
            <div class="kpi-card"><div class="kpi-icon bg-grad-amber"><i class="fa-solid fa-route"></i></div>
                <div class="kpi-val" id="sumTravel">0.00</div><div class="kpi-lbl">Travel Hours</div></div>
            <div class="kpi-card"><div class="kpi-icon bg-grad-green"><i class="fa-solid fa-stopwatch"></i></div>
                <div class="kpi-val" id="sumStd">0.00</div><div class="kpi-lbl">Task Standard Hrs (sum)</div></div>
            <div class="kpi-card"><div class="kpi-icon bg-grad-purple"><i class="fa-solid fa-layer-group"></i></div>
                <div class="kpi-val" id="sumLines">0</div><div class="kpi-lbl">Task Lines</div></div>
        </div>
        <div class="mt-3">
            <label class="form-label">Remarks</label>
            <textarea asp-for="Header.Remarks" class="form-control" rows="2" maxlength="1000"></textarea>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="fa-solid fa-floppy-disk me-2"></i>@(Model.IsEditMode ? "Update Time Sheet" : "Save / Post")</button>
        <a asp-page="/TimeBooking/Index" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate-left me-2"></i>Cancel</a>
        @if (Model.IsEditMode && Model.IsAdmin)
        {
            <button type="submit" asp-page-handler="Void" asp-route-tsId="@Model.TsId"
                    class="btn btn-outline-danger ms-auto" formnovalidate
                    onclick="return confirm('Void this time sheet? It will be removed from the active list.');">
                <i class="fa-solid fa-ban me-2"></i>Void Time Sheet</button>
        }
    </div>
</form>

<!-- ===================== ADD TASK MODAL ===================== -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="taskModalTitle"><i class="fa-solid fa-plus me-2 text-primary"></i>Add Task Line</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-danger py-2 d-none" id="modalError"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Task <span class="req">*</span></label>
                        <select id="m_task" class="form-select">
                            <option value="">— Select Task —</option>
                            @foreach (var t in Model.Tasks)
                            {
                                <option value="@t.TASK_CODE" data-name="@t.TASK_NAME" data-skill="@t.DEFAULT_SKILL" data-std="@t.STD_HOURS.ToString(inv)">@t.TASK_NAME</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Technician <span class="req">*</span></label>
                        <select id="m_tech" class="form-select">
                            <option value="">— Select Technician —</option>
                            @foreach (var tech in Model.Technicians)
                            {
                                <option value="@tech.PEMP_EMP_CODE" data-name="@tech.PEMP_EMP_NAME">@tech.PEMP_EMP_CODE — @tech.PEMP_EMP_NAME</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Skill</label>
                        <select id="m_skill" class="form-select">
                            <option>Lead Hand</option><option>Assistant</option><option>Technician</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Job Location <span class="req">*</span></label>
                        <select id="m_location" class="form-select">
                            @foreach (var loc in Model.Locations)
                            {
                                <option value="@loc.CODE">@loc.NAME</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Date <span class="req">*</span></label>
                        <input id="m_date" class="form-control tm-pick" placeholder="Select date" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Lunch Break (hh:mm)</label>
                        <input id="m_lunch" class="form-control tm-pick" placeholder="00:30" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Start Time <span class="req">*</span></label>
                        <input id="m_start" class="form-control tm-pick" placeholder="08:00" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">End Time <span class="req">*</span></label>
                        <input id="m_end" class="form-control tm-pick" placeholder="17:00" />
                        <span class="text-muted small" id="m_overnight" style="display:none"><i class="fa-solid fa-moon me-1"></i>Ends next day</span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Net Hrs <span class="badge-soft badge-status">auto</span></label>
                        <input id="m_net" class="form-control field-auto" readonly />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Time Type <span class="badge-soft badge-status">auto</span></label>
                        <div id="m_timetype" class="form-control field-auto">—</div>
                    </div>
                </div>

                <div class="section-h mt-4">
                    <i class="fa-solid fa-calculator"></i> Hours &amp; Cost
                    <span class="text-muted small fw-normal ms-2">auto-calculated from duty timings &amp; labour rate — adjust any value if needed</span>
                    <span id="m_calcStatus" class="ms-auto small text-muted"></span>
                    <button type="button" id="m_recalc" class="btn btn-outline-secondary btn-sm ms-2" title="Discard adjustments and recalculate">
                        <i class="fa-solid fa-rotate me-1"></i>Recalculate</button>
                </div>
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Normal Hrs <span class="tm-adj" data-for="normal"></span></label>
                        <input id="m_normal" type="number" step="0.25" min="0" class="form-control tm-editable" data-key="normal" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">OT Hrs <span class="tm-adj" data-for="ot"></span></label>
                        <input id="m_ot" type="number" step="0.25" min="0" class="form-control tm-editable" data-key="ot" />
                        <span class="text-muted small">Normal + OT = Net; editing one moves hours to the other.</span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Rate (Normal) <span class="tm-adj" data-for="rate"></span></label>
                        <input id="m_rate" type="number" step="0.01" min="0" class="form-control tm-editable" data-key="rate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">OT Rate <span class="tm-adj" data-for="otRate"></span></label>
                        <input id="m_otrate" type="number" step="0.01" min="0" class="form-control tm-editable" data-key="otRate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Labour Cost <span class="tm-adj" data-for="cost"></span></label>
                        <input id="m_cost" type="number" step="0.01" min="0" class="form-control tm-editable" data-key="cost" />
                        <span class="text-muted small">Normal × Rate + OT × OT Rate</span>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Food Allowance <span class="tm-adj" data-for="food"></span></label>
                        <input id="m_food" type="number" step="0.01" min="0" class="form-control tm-editable" data-key="food" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Total Cost <span class="badge-soft badge-status">auto</span></label>
                        <input id="m_total" class="form-control field-auto fw-semibold" readonly />
                        <span class="text-muted small">Labour Cost + Food Allowance</span>
                    </div>
                </div>

                <div class="section-h mt-4"><i class="fa-solid fa-route"></i> Travel <span class="text-muted small fw-normal ms-2">optional</span></div>
                <div class="row g-3">
                    <div class="col-md-5">
                        <label class="form-label">Travel Site</label>
                        <input id="m_travel_site" class="form-control" maxlength="200" placeholder="e.g. Customer site, Ruwais" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Travel Start</label>
                        <input id="m_travel_start" class="form-control tm-pick" placeholder="hh:mm" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Travel End</label>
                        <input id="m_travel_end" class="form-control tm-pick" placeholder="hh:mm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Total Travel Hrs <span class="tm-adj" data-for="travel"></span></label>
                        <input id="m_travel_hours" type="number" step="0.25" min="0" class="form-control tm-editable" data-key="travel" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="addLineBtn"><i class="fa-solid fa-circle-plus me-2"></i><span id="addLineBtnText">Add to Grid</span></button>
            </div>
        </div>
    </div>
</div>

<!-- ===================== EXISTING SHEET PROMPT ===================== -->
<div class="modal fade" id="existingSheetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa-solid fa-file-circle-exclamation me-2 text-warning"></i>Time sheet already exists</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1">Job <strong id="es_job"></strong> already has time sheet <strong id="es_sheet"></strong>.</p>
                <p class="text-muted mb-0">Only one time sheet is kept per job. Open the existing sheet to add or adjust its task lines.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" id="es_cancel">Choose another job</button>
                <a class="btn btn-primary" id="es_open" href="#"><i class="fa-solid fa-arrow-up-right-from-square me-2"></i>Open Time Sheet</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>
    <script>
        // Duty-timing rules passed from the server (used only for the Normal/OT preview until the calc call returns).
        window.TM_DUTY = {
            start: "@Model.Duty.DUTY_START",
            end: "@Model.Duty.DUTY_END",
            lunch: @Model.Duty.DEFAULT_LUNCH_HOURS.ToString(inv),
            weekend: [@Html.Raw(string.Join(",", (Model.Duty.WEEKEND_DAYS ?? "")
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .Select(d => Enum.TryParse<DayOfWeek>(d, true, out var dow) ? ((int)dow).ToString() : null)
                        .Where(x => x != null)))]
        };
        window.TM_IS_EDIT = @(Model.IsEditMode ? "true" : "false");
        window.TM_TS_ID = @(Model.TsId?.ToString(inv) ?? "null");
        window.TM_POSTING_DATE = "@Model.Header.PostingDate.ToString("yyyy-MM-dd")";
        window.TM_URLS = {
            jobsByLocation: "@Html.Raw(Url.Page(null, "JobsByLocation"))",
            sheetByJob: "@Html.Raw(Url.Page(null, "SheetByJob"))",
            calcLine: "@Html.Raw(Url.Page(null, "CalcLine"))",
            entry: "@Html.Raw(Url.Page("/TimeBooking/Entry"))"
        };
        // Seed the grid with the sheet's existing task lines when editing a posted time sheet.
        window.TM_EXISTING_LINES = [
            @foreach (var l in Model.ExistingLines)
            {
                @:{
                @:  taskCode: "@Html.Raw(Javascript(l.TaskCode))", taskName: "@Html.Raw(Javascript(l.TaskName))",
                @:  stdHours: @l.StdHours.ToString(inv),
                @:  techCode: "@Html.Raw(Javascript(l.TechCode))", techName: "@Html.Raw(Javascript(l.TechName))",
                @:  skill: "@Html.Raw(Javascript(l.Skill))", location: "@Html.Raw(Javascript(l.Location))",
                @:  workDate: "@l.WorkDate.ToString("yyyy-MM-dd")", startTime: "@l.StartTime", endTime: "@l.EndTime",
                @:  lunch: @l.LunchHours.ToString(inv), net: @l.NetHours.ToString(inv),
                @:  normal: @l.NormalHours.ToString(inv), ot: @l.OtHours.ToString(inv),
                @:  rate: @l.Rate.ToString(inv), otRate: @l.OtRate.ToString(inv),
                @:  cost: @l.LabourCost.ToString(inv), food: @l.FoodAllowance.ToString(inv), total: @l.TotalCost.ToString(inv),
                @:  travelSite: "@Html.Raw(Javascript(l.TravelSite))", travelStart: "@l.TravelStart", travelEnd: "@l.TravelEnd",
                @:  travelHours: @l.TravelHours.ToString(inv),
                @:  timeType: "@l.TimeType", overridden: @(l.Overridden ? "true" : "false")
                @:},
            }
        ];
    </script>
    <script src="~/js/time-booking.js" asp-append-version="true"></script>
}

@functions {
    // Minimal JS-string escaper for values embedded in the inline TM_EXISTING_LINES literal.
    static string Javascript(string? s) => string.IsNullOrEmpty(s) ? "" :
        s.Replace("\\", "\\\\").Replace("\"", "\\\"").Replace("\r", "").Replace("\n", "\\n");
}
