@page
@model YesTm.Web.Features.TimeBooking.IndexModel
@{
    ViewData["Title"] = "Time Sheets";
    var fromStr = Model.DateFrom?.ToString("yyyy-MM-dd");
    var toStr = Model.DateTo?.ToString("yyyy-MM-dd");
}

<div class="page-head">
    <div>
        <h1 class="page-title"><span class="ico"><i class="fa-solid fa-clock"></i></span> Time Sheets</h1>
        <p class="page-sub">@(Model.ScopedToMe ? "Your recent time bookings." : "All recent time bookings across technicians.")</p>
    </div>
    <a asp-page="/TimeBooking/Entry" class="btn btn-primary"><i class="fa-solid fa-plus me-2"></i>New Time Booking</a>
</div>

@if (Model.IsOffline)
{
    <div class="alert alert-warning d-flex align-items-center" role="alert">
        <i class="fa-solid fa-plug-circle-xmark me-2"></i>
        <span>Database not reachable. Configure the Oracle connection string to view posted time sheets.</span>
    </div>
}

<div class="content-card">
    <form method="get" class="row g-2 align-items-end mb-3">
        <div class="col-md-4">
            <label class="form-label">Search</label>
            <input name="Search" value="@Model.Search" class="form-control" placeholder="Sheet no / job no / customer…" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Posting Date From</label>
            <input name="DateFrom" type="date" value="@fromStr" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Posting Date To</label>
            <input name="DateTo" type="date" value="@toStr" class="form-control" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary flex-fill"><i class="fa-solid fa-magnifying-glass me-1"></i>Apply</button>
            <a asp-page="/TimeBooking/Index" class="btn btn-outline-secondary" title="Clear filters"><i class="fa-solid fa-xmark"></i></a>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Sheet No</th>
                    <th>Posting Date</th>
                    <th>Job No</th>
                    <th>Customer</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th class="text-num">Net Hrs</th>
                    <th class="text-num">Labour Cost</th>
                    <th style="width:80px"></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Sheets.Count == 0)
                {
                    <tr><td colspan="9" class="grid-empty">No time sheets found.</td></tr>
                }
                else
                {
                    @foreach (var s in Model.Sheets)
                    {
                        <tr>
                            <td class="fw-semibold">@s.TS_SHEET_NO</td>
                            <td>@s.TS_POSTING_DATE.ToString("dd-MMM-yyyy")</td>
                            <td>@s.TS_JOB_CODE</td>
                            <td>@s.TS_CUSTOMER_NAME</td>
                            <td>@s.TS_LOCATION</td>
                            <td><span class="badge-soft badge-status">@s.TS_JOB_STATUS</span></td>
                            <td class="text-num">@s.TS_TOTAL_NET_HOURS.ToString("N2")</td>
                            <td class="text-num">@s.TS_TOTAL_LABOUR_COST.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-page="/TimeBooking/Entry" asp-route-tsId="@s.TS_ID"
                                   class="btn btn-sm btn-outline-primary" title="Edit time sheet"><i class="fa-solid fa-pen"></i></a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (Model.TotalCount > 0)
    {
        var from = (Model.PageNo - 1) * YesTm.Web.Features.TimeBooking.IndexModel.PageSize + 1;
        var to = Math.Min(Model.PageNo * YesTm.Web.Features.TimeBooking.IndexModel.PageSize, Model.TotalCount);
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="text-muted small">Showing @from–@to of @Model.TotalCount</span>
            @if (Model.TotalPages > 1)
            {
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNo <= 1 ? "disabled" : "")">
                            <a class="page-link" asp-page="/TimeBooking/Index"
                               asp-route-Search="@Model.Search" asp-route-DateFrom="@fromStr" asp-route-DateTo="@toStr"
                               asp-route-PageNo="@(Model.PageNo - 1)">Prev</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNo ? "active" : "")">
                                <a class="page-link" asp-page="/TimeBooking/Index"
                                   asp-route-Search="@Model.Search" asp-route-DateFrom="@fromStr" asp-route-DateTo="@toStr"
                                   asp-route-PageNo="@p">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.PageNo >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-page="/TimeBooking/Index"
                               asp-route-Search="@Model.Search" asp-route-DateFrom="@fromStr" asp-route-DateTo="@toStr"
                               asp-route-PageNo="@(Model.PageNo + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
</div>
