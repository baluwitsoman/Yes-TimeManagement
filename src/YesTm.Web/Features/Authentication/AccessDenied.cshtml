@page
@{
    ViewData["Title"] = "Access Denied";
}
<div class="content-card text-center py-5">
    <div class="display-1 text-warning mb-3"><i class="fa-solid fa-ban"></i></div>
    <h1 class="h3">Access Denied</h1>
    <p class="text-muted">You do not have permission to view this page. If you believe this is an error, contact your administrator.</p>
    <a class="btn btn-primary mt-2" asp-page="/Dashboard/Index"><i class="fa-solid fa-house me-2"></i>Back to Dashboard</a>
</div>
